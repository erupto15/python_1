# Local app runtime. Copy to .env and fill local values.
APP_ENV=development
DATABASE_URL=sqlite:///./climbing-guidebook/backend/climbing.db
JWT_SECRET=dev-only-change-me
ADMIN_EMAIL=admin@climbing-guidebook.local
ADMIN_PASSWORD=change-me-now
ADMIN_DISPLAY_NAME=Administrator

# Token of a separate local test bot. The production bot token lives on the VPS.
TELEGRAM_BOT_TOKEN=
TELEGRAM_AUTH_MAX_AGE_SEC=86400
TELEGRAM_WEBHOOK_SECRET=
DISABLE_CATALOG_SEED=1

# Optional operator/deploy settings for emergency manual deploys.
DEPLOY_HOST=92.246.76.142
DEPLOY_USER=root
DEPLOY_KEY=/Users/<you>/.ssh/id_ed25519_vlad
DEPLOY_BRANCH=main
APP_DIR=/opt/guide-rus/current
PUBLIC_URL=https://92.246.76.142.sslip.io

# Production bot token for Bot API operator commands only.
# Do not use it as local TELEGRAM_BOT_TOKEN.
PROD_TELEGRAM_BOT_HTTP_API=

# Timeweb Managed PostgreSQL for operational scripts/dump/restore.
POSTGRESQL_HOST=
POSTGRESQL_HOST_PRIVATE=
POSTGRESQL_PORT=5432
POSTGRESQL_DATABASE=
POSTGRESQL_USER=
POSTGRESQL_PASSWORD=

# Timeweb S3/object storage
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=ru-1