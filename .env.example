# Operator/deploy environment. Copy to .env locally and fill with real values.
# Do not use this file as climbing-guidebook/backend/.env.

# SSH access to Timeweb VPS
DEPLOY_HOST=92.246.76.142
DEPLOY_USER=root
DEPLOY_KEY=/Users/<you>/.ssh/id_ed25519_vlad
DEPLOY_BRANCH=main
APP_DIR=/opt/guide-rus/current
PUBLIC_URL=https://92.246.76.142.sslip.io

# Telegram bot token for operator scripts/Bot API calls.
TELEGRAM_BOT_HTTP_API=

# Timeweb Managed PostgreSQL for operational scripts/dump/restore.
POSTGRESQL_HOST=
POSTGRESQL_HOST_PRIVATE=
POSTGRESQL_PORT=5432
POSTGRESQL_DATABASE=
POSTGRESQL_USER=
POSTGRESQL_PASSWORD=
DATABASE_URL=

# Timeweb S3/object storage for future backups.
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=ru-1

# Optional source DB variables for one-off migrations.
OLD_DB_CONNECTION_STRING=
OLD_DB_PASSWORD=
