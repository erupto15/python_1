# Local app runtime. Copy to .env and fill local values.
APP_ENV=development
DATABASE_URL=sqlite:///./climbing-guidebook/backend/climbing.db
JWT_SECRET=dev-only-change-me
ADMIN_EMAIL=admin@climbing-guidebook.local
ADMIN_PASSWORD=admin
ADMIN_DISPLAY_NAME=Administrator

# Token of a separate local test bot. The production bot token lives on the VPS.
TELEGRAM_BOT_TOKEN=
DISABLE_CATALOG_SEED=1

# SMTP for password reset emails (a new random password per request). Without SMTP_HOST, password reset returns 503.
# Yandex example: SMTP_HOST=smtp.yandex.ru, SMTP_PORT=465, SMTP_SECURITY=ssl,
# SMTP_USER=<box>@yandex.ru, SMTP_PASSWORD=<app password from id.yandex.ru → Security → App passwords>.
# SMTP_SECURITY: ssl (implicit TLS, usually 465) | starttls (usually 587) | none.
# SMTP_FROM defaults to SMTP_USER; for Yandex it must match the mailbox.
# SMTP_HOST=smtp.yandex.ru
# SMTP_PORT=465
# SMTP_SECURITY=ssl
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=

# Optional: CARTO Voyager basemap tiles (free key: https://carto.com/basemaps/apikey/)
# CARTO_BASEMAPS_API_KEY=

# Optional: vision/text assistant for catalog drafts (OpenAI-compatible)
# ASSISTANT_API_KEY=
# ASSISTANT_API_BASE=https://api.openai.com/v1
# ASSISTANT_MODEL=gpt-4o-mini
