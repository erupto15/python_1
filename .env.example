# Local app runtime. Copy to .env and fill local values.
APP_ENV=development
DATABASE_URL=sqlite:///./climbing-guidebook/backend/climbing.db
JWT_SECRET=dev-only-change-me
ADMIN_EMAIL=admin@climbing-guidebook.local
ADMIN_PASSWORD=admin
ADMIN_DISPLAY_NAME=Administrator

# Token of a separate local test bot. The production bot token lives on the VPS.
TELEGRAM_BOT_TOKEN=
TELEGRAM_AUTH_MAX_AGE_SEC=86400
DISABLE_CATALOG_SEED=1

# Optional: CARTO Voyager basemap tiles (free key: https://carto.com/basemaps/apikey/)
# CARTO_BASEMAPS_API_KEY=

# Optional: vision/text assistant for catalog drafts (OpenAI-compatible)
# ASSISTANT_API_KEY=
# ASSISTANT_API_BASE=https://api.openai.com/v1
# ASSISTANT_MODEL=gpt-4o-mini
