# Render production env template
# Copy values into Render -> Web Service -> Environment

# Required: PostgreSQL URL (Render Postgres or Supabase)
# Supabase example:
# DATABASE_URL=postgresql+psycopg2://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Enable production safeguards (SQLite is blocked in production)
APP_ENV=production

# Security (generate strong secret)
JWT_SECRET=

# Admin bootstrap account
ADMIN_EMAIL=admin@climbing-guidebook.local
ADMIN_PASSWORD=change-me-now
ADMIN_DISPLAY_NAME=Administrator

# Telegram Mini App auth
TELEGRAM_BOT_TOKEN=
TELEGRAM_AUTH_MAX_AGE_SEC=86400
