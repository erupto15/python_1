# Render Web Service → Environment (PostgreSQL)
# Скопируйте значения из Dashboard PostgreSQL → Connections (Internal) или Link Database.

APP_ENV=production

# Вариант A — отдельные поля
POSTGRES_HOST=your-render-postgres-internal-host
POSTGRES_PORT=5432
POSTGRES_USER=your_db_user
POSTGRES_DB=your_db_name
POSTGRES_PASSWORD=

# Вариант B — одна строка после Link Database в Render:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE

JWT_SECRET=
ADMIN_EMAIL=admin@climbing-guidebook.local
ADMIN_PASSWORD=change-me-now
ADMIN_DISPLAY_NAME=Administrator
TELEGRAM_BOT_TOKEN=
TELEGRAM_AUTH_MAX_AGE_SEC=86400
