# Скопируйте в .env и подставьте значения из Supabase:
#   Project Settings → Database → Connection string → URI → Transaction (port 6543)

# Вариант 1 — отдельные поля (как в .env):
POSTGRES_HOST=db.YOUR_PROJECT_REF.supabase.co
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_DB=postgres
POSTGRES_PASSWORD=YOUR_DB_PASSWORD

# Вариант 2 — одна строка:
# DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

APP_ENV=production

# openssl rand -hex 32
JWT_SECRET=

ADMIN_EMAIL=admin@climbing-guidebook.local
ADMIN_PASSWORD=change-me-now
ADMIN_DISPLAY_NAME=Administrator

# Токен бота из @BotFather — для входа в Telegram Mini App
TELEGRAM_BOT_TOKEN=

# Ежедневная синхронизация / бэкап (python backup_supabase_daily.py)
# BACKUP_DIR=./data/backups
# BACKUP_KEEP_DAYS=30
# SQLITE_MIRROR_PATH=./data/local_db/guidebook_mirror.db
