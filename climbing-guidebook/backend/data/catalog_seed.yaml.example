# Скопируйте в catalog_seed.yaml — данные загрузятся в PostgreSQL при bootstrap / старте API.
# Повторный запуск не дублирует записи (поиск по названию района / сектора / трассы).

areas:
  - name: "Общий район"
    description: "Стартовый район из seed"
    access: "Как добраться до района, пропуска, ограничения доступа"
    season: "Лучший сезон и погодные особенности"
    parking: "Где оставить машину"
    approach: "Общий подход к массиву"
    warnings: "Опасности, правила и важные предупреждения"
    image_url: ""
    latitude: null
    longitude: null
    sectors:
      - name: "Сектор по умолчанию"
        description: ""
        access: ""
        season: ""
        parking: ""
        approach: "Подход к конкретной стене / блоку"
        warnings: ""
        routes:
          - name: "Пример трассы"
            grade: "6a"
            description: "Добавлена из catalog_seed.yaml"
            length_m: 18
            bolts: 8
            rating: null
            latitude: null
            longitude: null
        boulders: []
