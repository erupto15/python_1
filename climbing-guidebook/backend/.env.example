# Local default. Production on Timeweb uses PostgreSQL DATABASE_URL below.
DATABASE_URL=sqlite:///./climbing.db

# Путь к YAML-конфигу (по умолчанию backend/config/settings.yaml)
# CONFIG_FILE=config/settings.yaml

# Для production:
# APP_ENV=production
# DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/DB?sslmode=require

# JWT (обязательно смените в продакшене)
JWT_SECRET=

# Администратор каталога (трассы / боулдеринг). Создаётся при старте, если такого email ещё нет.
ADMIN_EMAIL=admin@climbing-guidebook.local
ADMIN_PASSWORD=change-me-now
ADMIN_DISPLAY_NAME=Administrator

# Telegram Mini App auth (подпись initData на сервере)
TELEGRAM_BOT_TOKEN=
TELEGRAM_AUTH_MAX_AGE_SEC=86400

# После миграции каталога в БД seed должен быть отключен на сервере.
DISABLE_CATALOG_SEED=1
