<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Автозапуск бэкапа раз в сутки на macOS (launchd).

  1. Отредактируйте пути в ProgramArguments (run_daily_backup.sh).
  2. Скопируйте:
       cp com.climbing.guidebook.daily-backup.plist.example \
          ~/Library/LaunchAgents/com.climbing.guidebook.daily-backup.plist
  3. Загрузите:
       launchctl load ~/Library/LaunchAgents/com.climbing.guidebook.daily-backup.plist
  4. Проверка вручную:
       launchctl start com.climbing.guidebook.daily-backup
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.climbing.guidebook.daily-backup</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/vladik/pytest_new/python_1/climbing-guidebook/backend/run_daily_backup.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>3</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/vladik/pytest_new/python_1/climbing-guidebook/backend/data/backups/logs/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/vladik/pytest_new/python_1/climbing-guidebook/backend/data/backups/logs/launchd.err.log</string>
  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
